import "@typespec/http";
import "@typespec/openapi3";

using Http;

@service(#{ title: "Raven" })
@server("https://example.com", "Single server endpoint")
namespace Raven;

@doc("JWT bearer token authentication")
model BearerAuth {
  type: "http";
  scheme: "bearer";
  bearerFormat: "JWT";
}

model SetAuthCookieResponse {
  @header("Set-Cookie")
  @doc("Contains the HTTP-only refresh token cookie for web clients.")
  setCookie: string;
}

@doc("Base structure for all API responses")
model ApiResponseBase {
  @doc("Indicates whether the request was successful")
  success: boolean;

  @doc("Optional human-readable message")
  message?: string;
}

@doc("Cursor-based pagination for infinite scrolling")
model CursorPagination {
  @doc("The current cursor position")
  cursor?: string | null;

  @doc("The next cursor position for fetching the next set of data")
  nextCursor?: string | null;

  @doc("Indicates if there are more pages to fetch")
  hasNextPage: boolean;
}

@doc("Tweet summary response generated by AI")
model TweetSummaryResponse {
  @doc("The ID of the tweet")
  id: string;

  @doc("AI-generated summary of the tweet content")
  summary: string;
}

@doc("Success response wrapper with data")
model ApiSuccessResponse<T> {
  success: true;
  message?: string;
  data: T;
}

@doc("Success response wrapper with data and pagination")
model ApiSuccessResponseWithPagination<T> {
  success: true;
  message?: string;
  data: T;
  pagination: CursorPagination;
}

@doc("Success response for operations that only return a message (like POST/DELETE)")
model ApiMessageResponse {
  success: true;
  message?: string;
}

@doc("Error response wrapper")
model ApiErrorResponse {
  success: false;
  error: {
    code: string;
    message?: string;
  };
}

@doc("Validation error response wrapper")
model ApiValidationErrorResponse {
  success: false;
  error: {
    code: "VALIDATION_ERROR";
    message?: string;
    errors: {
      field: string;
      code: string;
      message?: string;
    }[];
  };
}

@doc("Standard error codes used across the API")
enum ErrorCode {
  // Authentication & Authorization (401, 403)
  INVALID_TOKEN: "INVALID_TOKEN",

  TOKEN_EXPIRED: "TOKEN_EXPIRED",
  UNAUTHORIZED: "UNAUTHORIZED",
  FORBIDDEN: "FORBIDDEN",

  // Validation (400)
  VALIDATION_ERROR: "VALIDATION_ERROR",

  INVALID_INPUT: "INVALID_INPUT",

  // Resource errors (404, 409)
  NOT_FOUND: "NOT_FOUND",

  ALREADY_EXISTS: "ALREADY_EXISTS",

  // Rate limiting (429)
  RATE_LIMIT_EXCEEDED: "RATE_LIMIT_EXCEEDED",

  // Server errors (500)
  INTERNAL_SERVER_ERROR: "INTERNAL_SERVER_ERROR",
}

@doc("Validation-specific error codes")
enum ValidationErrorCode {
  REQUIRED_FIELD: "REQUIRED_FIELD",
  INVALID_FORMAT: "INVALID_FORMAT",
  INVALID_LENGTH: "INVALID_LENGTH",
  INVALID_VALUE: "INVALID_VALUE",
}

@doc("Standard 400 Bad Request response")
model BadRequestResponse {
  ...Response<400>;
  ...Body<ApiErrorResponse>;
}

@doc("Standard 401 Unauthorized response")
model UnauthorizedResponse {
  ...Response<401>;
  ...Body<ApiErrorResponse>;
}

@doc("standard 410 Gone response")
model GoneResponse {
  ...Response<410>;
  ...Body<ApiErrorResponse>;
}

@doc("Standard 403 Forbidden response")
model ForbiddenResponse {
  ...Response<403>;
  ...Body<ApiErrorResponse>;
}

@doc("Standard 404 Not Found response")
model NotFoundResponse {
  ...Response<404>;
  ...Body<ApiErrorResponse>;
}

@doc("Standard 409 Conflict response")
model ConflictResponse {
  ...Response<409>;
  ...Body<ApiErrorResponse>;
}

@doc("Standard 422 Validation Error response")
model ValidationErrorResponse {
  ...Response<422>;
  ...Body<ApiValidationErrorResponse>;
}

@doc("Standard 429 Rate Limit Exceeded response")
model RateLimitResponse {
  ...Response<429>;
  ...Body<ApiErrorResponse>;
}

@doc("Standard 500 Internal Server Error response")
model InternalServerErrorResponse {
  ...Response<500>;
  ...Body<ApiErrorResponse>;
}

@doc("Single user session, providing details about the device, location, and activity status.")
model SessionResponse {
  @doc("Unique identifier for the session.")
  id: string;

  @doc("The type of device or client used for this session (e.g., 'Linux', 'Android', 'Web', 'Windows').")
  deviceType: string;

  @doc("The location where the session was initiated or active")
  location: string | null;

  @doc("The UTC timestamp indicating the last time this session was active. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  lastActive: utcDateTime;

  @doc("A boolean flag indicating whether this session is the one currently making the API request.")
  isCurrent: boolean;
}

@doc("A single external social account connected to the user's primary account.")
model ConnectedAccountResponse {
  @doc("The name of the external provider (e.g., 'google', 'github').")
  provider: string;

  @doc("The unique identifier (e.g., email address) associated with the user")
  displayIdentifier: string;

  @doc("The connection status.")
  status: "Connected" | "Error";

  @doc("The timestamp when this external account was first linked. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  connectedAt: utcDateTime;
}

@doc("Country information for user settings and selection dropdowns")
model Country {
  @doc("ISO 3166-1 alpha-2 country code (e.g., 'US', 'EG', 'GB')")
  code: string;

  @doc("Full country name (e.g., 'United States of America', 'Egypt', 'United Kingdom of Great Britain and Northern Ireland')")
  name: string;
}

model Interest {
  @doc("Interest code identifier (e.g., 'TECH', 'SPORTS')")
  code: InterestCode;

  @doc("Display name of the interest (e.g., 'Tech', 'Sports')")
  name: string;

  @doc("Indicates whether the user has selected this interest")
  isSelected: boolean;
}

@doc("Entity mention in bio")
model MentionEntity {
  @doc("The username of the mentioned user")
  username: string; //we expose text but store as user id and hydrate

  @doc("Start position of the mention in the bio text")
  startPosition: int32;
}

@doc("Entity hashtag in bio")
model HashtagEntity {
  @doc("The hashtag text (without #)")
  hashtag: string;

  @doc("Start position of the hashtag in the bio text")
  startPosition: int32;
}

@doc("Bio entities containing mentions and hashtags")
model BioEntities {
  @doc("Array of mention entities in the bio")
  mentions?: MentionEntity[];

  @doc("Array of hashtag entities in the bio")
  hashtags?: HashtagEntity[];
}

@doc("Entities containing mentions and hashtags for tweet content")
model TweetEntities {
  @doc("Array of mention entities in the tweet")
  mentions: MentionEntity[] | null;

  @doc("Array of hashtag entities in the tweet")
  hashtags: HashtagEntity[] | null;
}

@doc("Entity media in tweet.")
model MediaEntity {
  @doc("Unique identifier for the media item.")
  id: string;

  ...MediaItem;
}

@doc("Preview of a hashtag/ keyword with its usage statistics")
model HashtagPreview {
  @doc("The hashtag text (without #)/ The keyword")
  hashtag: string;

  @doc("Number of tweets using this hashtag/ keyword")
  tweetsCount: integer;

  @doc("The category this tweet is trending in (e.g., 'news', 'sports', 'entertainment', or 'general')")
  category: string;
}

@doc("Compact user(followers/following) lists")
model CompactUser {
  @doc("The user's unique, public-facing username.")
  @minLength(1)
  username: string;

  @doc("The user's display name.")
  @minLength(1)
  @maxLength(100)
  displayName: string;

  @doc("The user's bio (max 160 characters).")
  @maxLength(160)
  bio: string | null;

  @doc("Entities in the bio (mentions and hashtags)")
  bioEntities: BioEntities | null;

  @doc("URL to the user's avatar image")
  avatarUrl: string | null;
}

@doc("Public-facing user profile (visible to others)")
model PublicUser {
  ...CompactUser;

  @doc("URL to the user's banner image")
  bannerUrl: string | null;

  @doc("User's location")
  @maxLength(100)
  location: string | null;

  @doc("User's website URL")
  @maxLength(255)
  websiteUrl: string | null;

  @doc("User's date of birth (YYYY-MM-DD). ISO 8601 date format.")
  birthDate: plainDate | null;

  @doc("Date when the user joined. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  joinedAt: utcDateTime;
}

@doc("Authenticated user profile (includes private data)")
model AuthenticatedUser {
  ...PublicUser;

  @doc("User's email address (private)")
  email: string;

  @doc("User's phone number (private)")
  phone: string | null;

  @doc("User's language preference")
  languageCode: LanguageCode = LanguageCode.EN;
}

@doc("User's biography with structured entities")
model UserBio {
  @doc("The user's bio text (max 160 characters)")
  @maxLength(160)
  text: string | null;

  @doc("Structured entities found in the bio (mentions and hashtags)")
  bioEntities: BioEntities | null;
}

@doc("Metadata for user sent in suggestions/tweets/search results/etc.")
model UserMetadata {
  @doc("The user's unique, public-facing username.")
  @minLength(1)
  username: string;

  @doc("The user's display name.")
  @minLength(1)
  @maxLength(100)
  displayName: string;

  @doc("URL to the user's avatar image")
  avatarUrl: string;
}

@doc("Model for follow suggestions")
model FollowSuggestionData {
  ...UserMetadata;

  @doc("The user's biography with structured entities")
  bio: string | null;

  @doc("Structured entities found in the bio (mentions and hashtags)")
  bioEntities: BioEntities | null;

  @doc("Relationship information for the suggested user")
  relationship: {
    @doc("True if this user is following the current user")
    isFollower: boolean;
  };
}

@doc("Metadata for user with the last seen message id for the other user ")
model UserMetadataWithLastSeen {
  ...UserMetadata;

  @doc("The ID of the last message seen from the other user in a conversation")
  otherParticipantLastSeenMessageId: string | null;
}

@doc("Author metadata for tweets with relationship status")
model TweetAuthor {
  ...UserMetadata;

  @doc("True if the current user has blocked this author")
  isBlocked: boolean;

  @doc("True if the current user has muted this author")
  isMuted: boolean;

  @doc("True if the current user is following this author")
  isFollowing: boolean;
}

model UserMetadataWithFollowInfo {
  ...UserMetadata;

  @doc("Is the user following the current logged-in user")
  isFollower: boolean | null;

  @doc("Is the user followed by the current logged-in user")
  isFollowing: boolean | null;
}

model UserMetadataWithFollowing {
  ...UserMetadata;

  @doc("Is the user followed by the current logged-in user")
  isFollowing: boolean;
}

@doc("User metadata with biography information")
model UserMetadataWithBio {
  ...UserMetadataWithFollowInfo;

  @doc("The user's biography with structured entities")
  bio: UserBio | null;

  @doc("True if the current user has blocked this user")
  isBlocked: boolean;

  @doc("True if the current user has muted this user")
  isMuted: boolean;
}

@doc("Block relationship state between two users")
model BlockRelationship {
  @doc("Indicates if the requesting user has blocked the other user")
  isBlocking: boolean;

  @doc("Indicates if requesting user is blocked by the other user")
  isBlockedBy: boolean;
}

@doc("Relationship state between the current user and the subject user. Defines blocking and muting status")
model UserRelationship {
  @doc("True if the current user has blocked this user, preventing them from viewing their profile or interacting.")
  blocking: boolean;

  @doc("True if this user has blocked the current user.")
  blockedBy: boolean;

  @doc("True if the current user has muted this user, hiding their posts from the feed without unfollowing.")
  muted: boolean;

  @doc("Is the user followed by the current logged-in user")
  following: boolean;

  @doc("Is the user following the current logged-in user")
  follower: boolean;
}

@doc("Complete user profile with full account details and relationship context.")
model UserProfile {
  ...PublicUser;

  @doc("Relationship state between the authenticated user and this profile user, including blocks and mutes.")
  relationship: UserRelationship | null; // null if get my profile

  @doc("The number of users this user is following")
  followingCount: int64;

  @doc("The number of followers this user has")
  followersCount: int64;

  @doc("The number of mutual followers shared with the authenticated user")
  mutualsCount: int64 | null;

  @doc("Mutual users of up to 3 mutual followers shown before clicking 'View all mutuals'")
  @maxItems(3)
  mutualUsers: MutualUsers[] | null;
}

model MutualUsers {
  @doc("Mutual user display name")
  displayName: string;

  @doc("Mutual user avatar url")
  avatarUrl: string;
}

@doc("Extended user metadata displayed in hover cards and user previews")
model UserPreview {
  ...UserMetadataWithBio;

  @doc("The number of users this user is following")
  followingCount: int64;

  @doc("The number of followers this user has")
  followersCount: int64;

  @doc("The number of mutual followers shared with the authenticated user")
  mutualsCount: int64 | null;

  @doc("Display names of up to 3 mutual followers shown before clicking 'View all mutuals'")
  @maxItems(3)
  mutualUsers: string[] | null;
}

@doc("Request body for updating profile")
model UpdateProfileRequest {
  @doc("The user's display name.")
  @minLength(1)
  @maxLength(100)
  displayName?: string;

  @doc("The user's bio (max 160 characters).")
  @maxLength(160)
  bio?: string | null;

  @doc("The user's bio entities (hashtags, mentions).")
  bioEntities?: BioEntities | null;

  @doc("User's location")
  @maxLength(100)
  location?: string | null;

  @doc("User's website URL")
  @maxLength(255)
  websiteUrl?: string | null;

  @doc("User's date of birth (YYYY-MM-DD). ISO 8601 date format.")
  birthDate?: plainDate | null;

  @doc("URL to the user's avatar image. Must be a valid URL (https://www.example.com).")
  @maxLength(255)
  avatarUrl?: string | null;

  @doc("URL to the user's banner image. Must be a valid URL (https://www.example.com).")
  @maxLength(255)
  bannerUrl?: string | null;
}

model UpdatedProfile {
  @doc("The user's display name.")
  displayName: string | null;

  @doc("The user's bio (max 160 characters).")
  bio: string | null;

  @doc("The user's bio entities (hashtags, mentions).")
  bioEntities: BioEntities | null;

  @doc("The user's location.")
  location: string | null;

  @doc("The user's website URL.")
  websiteUrl: string | null;

  @doc("URL to the user's avatar image")
  avatarUrl: string | null;

  @doc("URL to the user's banner image")
  bannerUrl: string | null;

  @doc("The timestamp when the profile was last updated.")
  updatedAt: utcDateTime;
}

model UploadImageRequest {
  @doc("Image file to upload (jpg, jpeg, png, webp). Max size: 5MB")
  file: HttpPart<bytes>;

  @doc("Alt text for accessibility (optional)")
  altText?: HttpPart<string>;

  @doc("Folder to store the media in (avatars, banners, tweets, messages)")
  folder: HttpPart<"avatars" | "banners" | "tweets" | "messages">;
}

model UploadVideoRequest {
  @doc("Video file to upload (mp4, mov). Max size: 10MB")
  file: HttpPart<bytes>;

  @doc("Alt text for accessibility (optional)")
  altText?: HttpPart<string>;

  @doc("Folder to store the media in (avatars, banners, tweets, messages)")
  folder: HttpPart<"avatars" | "banners" | "tweets" | "messages">;
}

model UploadGifBody {
  @doc("Tenor GIF ID to attach")
  tenorId: string;
}

model UploadGifResponse {
  @doc("Unique identifier for the uploaded GIF")
  id: string;

  @doc("URL to access the uploaded GIF")
  url: string;

  @doc("Width of the GIF in pixels")
  width: integer;

  @doc("Height of the GIF in pixels")
  height: integer;

  @doc("Alt text for accessibility (if provided)")
  altText?: string;
}

@doc("The type of media file.")
enum MediaType {
  IMAGE,
  VIDEO,
  GIF,
}

@doc("Detailed information about an attached media item.")
model MediaItem {
  @doc("The type of media.")
  type: MediaType;

  @doc("URL to access the media file.")
  url: string;

  @doc("Alt text for accessibility.")
  altText: string;

  @doc("The width of the media item (in pixels for image/video).")
  width: int32;

  @doc("The height of the media item (in pixels for image/video).")
  height: int32;
}

@doc("The content and optional media for creating a new tweet")
model TweetBody {
  @doc("Text content of the tweet (max 280 characters).")
  @maxLength(280)
  content: string | null;

  @doc("Optional array of media items attached to the tweet (max 4 items)")
  @maxItems(4)
  media?: string[] | null;

  @doc("The ID of the tweet this one is a reply to.")
  replyToTweetId?: string | null;

  @doc("The ID of the tweet being quoted.")
  quoteToTweetId?: string | null;
}

@doc("A compact representation of a tweet, used when nesting or in lists.")
model CompactTweet {
  @doc("The unique identifier for the tweet.")
  id: string;

  @doc("The user who created the tweet.")
  author: TweetAuthor;

  @doc("The text content of the tweet.")
  content: string | null;

  @doc("The time the tweet was created. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  createdAt: utcDateTime;

  @doc("Number of replies to this tweet.")
  replyCount: int32;

  @doc("Number of retweets of this tweet.")
  retweetCount: int32;

  @doc("Number of likes on this tweet.")
  likeCount: int32;

  @doc("Indicates if the authenticated user has liked this tweet.")
  isLiked: boolean;

  @doc("Indicates if the authenticated user has retweeted this tweet.")
  isRetweeted: boolean;

  @doc("Structured data entities (mentions, hashtags) found in the tweet content.")
  entities: TweetEntities;

  @doc("Optional array of media ids attached to the tweet (max 4 items)")
  media: MediaItem[] | null;
}

model ReplyTweet extends CompactTweet {
  @doc("The ID of the tweet this one is a reply to.")
  replyToTweetId: string;
}

model Tweet {
  ...CompactTweet;

  @doc("The ID of the tweet this one is a reply to.")
  replyToTweetId: string | null;

  @doc("The ID of the tweet being quoted.")
  quoteToTweetId: string | null;

  @doc("The full object of the tweet being quoted, for easy display.")
  quotedTweet: CompactTweet | null; // Hydrated object for a quoted tweet.

  repostedBy: {
    @doc("Username of the user who reposted this tweet")
    username: string;

    @doc("Display name of the user who reposted this tweet")
    displayName: string;
  }
}


model CreatedTweet {
  id: string;
  content?: string;
  media?: string[];
  entities?: TweetEntities;
  createdAt: utcDateTime;
  replyToTweetId?: string;
  quotedTweetId?: string;
}

model TweetWithReplyTo extends Tweet {
  @doc("The tweet that this tweet is replying to.")
  replyToTweet: CompactTweet | null;
}

model TweetWithoutQuotedTweet {
  ...CompactTweet;

  @doc("The ID of the tweet this one is a reply to.")
  replyToTweetId: string | null;
}

model TweetWithThread extends Tweet {
  @doc("The root tweet of the thread (oldest tweet in the chain).")
  rootTweet: CompactTweet | null;

  @doc("Parent tweets leading to this tweet (up to 4), ordered from oldest to newest, excluding the root tweet.")
  parentTweets: CompactTweet[] | null;

  @doc("Indicates if there are more parent tweets beyond the provided ones.")
  hasMoreParents: boolean;
}

@doc("Defines the filter categories for the notifications list.")
enum NotificationFilter {
  @doc("Show only conversational notifications like replies, mentions, and quotes.")
  mentions,
}

@doc("Summarizes the users (actors) who triggered a notification.")
model NotificationActorSummary {
  @doc("A sample of users for UI previews (e.g., 'Alex, Maria...').")
  @maxItems(3)
  previewActors: UserMetadataWithFollowing[];

  @doc("The total count of all users (e.g., for '...and 4 others').")
  @minValue(1)
  totalCount: int32;
}

@doc("Encapsulates the content payload of the notification.")
model NotificationTweetSummary {
  @doc("The actual tweet object to display as preview.")
  primaryTweet: Tweet;

  @doc("The total number of tweets involved in this aggregation.\n Use this for UI labels like 'Alex liked 5 tweets'.")
  totalCount: int32;

  @doc("IDs of all tweets involved in this notification (for client-side fetching if needed).")
  subjectIds: string[];
}

@doc("Represents a single notification item for a user.")
model Notification {
  @doc("Unique ID for the notification event.")
  id: string;

  @doc("The specific action that triggered this notification.")
  type: NotificationType;

  @doc("Summary of the user(s) who triggered this notification.")
  actorSummary: NotificationActorSummary;

  @doc("Summary of the tweet(s) involved in this notification.")
  tweetSummary: NotificationTweetSummary;

  @doc("Timestamp of the *latest* event in this aggregation. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  latestEventAt: utcDateTime;

  @doc("Indicates whether the notification has been seen.")
  isSeen: boolean;
}

enum NotificationType {
  FOLLOW: "FOLLOW",
  LIKE: "LIKE",
  REPLY: "REPLY",
  QUOTE: "QUOTE",
  RETWEET: "RETWEET",
  TWEET: "TWEET",
  MENTION: "MENTION",
}
@doc("Suggested mention item for mentions suggestions")
model MentionSuggestion {
  @doc("The username of the suggested user")
  username: string;

  @doc("The display name of the suggested user")
  displayName: string;

  @doc("URL to the user's avatar image")
  avatarUrl: string;
}

@doc("Query parameters for cursor-based pagination")
model CursorPaginationParameters {
  @query
  @doc("The cursor position to start fetching from")
  cursor?: string;

  @query
  @doc("The number of items to return per page (default: 20)")
  limit?: int32 = 20;
}

// Conversations / Messages related
@doc("Entities containing mentions and hashtags for message content")
model MessageEntities {
  @doc("Array of mention entities in the message")
  mentions: MentionEntity[] | null;

  @doc("Array of hashtag entities in the message")
  hashtags: HashtagEntity[] | null;
}

@doc("Reactions corresponding to a message")
model Reaction {
  @doc("The username of the user who reacted to the message")
  username: string;

  @doc("The display name of the user who reacted to the message")
  displayName: string;

  @doc("URL to the user's avatar image")
  avatarUrl: string;

  @doc("The reaction emoji (null if reaction was removed)")
  reaction: string | null;

  @doc("Timestamp when the reaction was made. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  reactedAt: utcDateTime;
}

@doc("Reactions for both participating users in the conversation")
model ConversationReactions {
  @doc("Reactions from the message sender user")
  sender: Reaction;

  @doc("Reactions from the other user in the conversation")
  receiver: Reaction;
}

@doc("A single message in a conversation")
model Message {
  @doc("Unique identifier for the message")
  id: string;

  @doc("Text content of the message (max 10,000 characters *For now)")
  @maxLength(10000)
  content: string;

  @doc("Structured data entities (mentions, hashtags) parsed from message content")
  entities: MessageEntities | null;

  @doc("Optional media URL attached to the message (single media is supported per message)")
  mediaUrl: string | null;

  @doc("Timestamp when the message was created/sent. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
  createdAt: utcDateTime;

  @doc("True if this message was sent by the authenticated user (Easy for client side)")
  isMine: boolean;

  @doc("Reactions corresponding to this message")
  reactions: ConversationReactions;
}

@doc("Unified conversation model")
model Conversation {
  @doc("Unique identifier for the conversation")
  id: string;

  @doc("The other participant in the 1:1 conversation")
  participant: UserMetadata;

  @doc("The most recent message in the conversation (needed in list view, null if no messages yet)")
  lastMessage: {
    @doc("Preview of the message content (may be truncated by frontend)")
    content: string;

    @doc("Username of the sender")
    senderUsername: string;

    @doc("Timestamp of the last message. ISO 8601 format (e.g., '2024-01-15T14:30:00Z').")
    sentAt: utcDateTime;
  } | null;

  ...BlockRelationship;

  @doc("True if notifications are muted for this conversation")
  isMuted: boolean;
}

@doc("Request body for sending a new message")
model SendMessageRequest {
  @doc("Text content of the message (max 10,000 characters)")
  @maxLength(10000)
  content: string;

  @doc("Optional media URL to attach (single media per message, max 2048 characters)")
  @maxLength(2048)
  mediaUrl?: string | null;
}

model TopSuggestedUsers {
  @doc("Suggested Users when typing")
  @maxItems(10)
  users: UserMetadataWithFollowInfo[];
}

model AllMatchingUsers {
  @doc("Paginated list of all matching users (default 20 per page)")
  users: UserMetadataWithFollowInfo[];
}

model SearchUser {
  ...UserMetadata;
  bio: string | null;
  bioEntities: BioEntities | null;
  bannerUrl: string | null;
  relationship: UserRelationship;
}

model TopHashtags {
  @doc("Top 3 relevant hashtags for the search query")
  @maxItems(3)
  hashtags: string[];
}

enum SearchTab {
  TOP: "top",
  LATEST: "latest",
  MEDIA: "media",
}

enum PeopleSearchFilter {
  Anyone: "anyone",
  Following: "following",
}

model SearchTweetsParameters {
  @doc("The search query")
  @query
  query: string;

  @doc("Tab type: top (default) | latest | media ")
  @query
  tab?: SearchTab;

  @doc("Show tweets from anyone (default) or only from people you follow")
  @query
  peopleFilter?: PeopleSearchFilter;

  @doc("Exclude tweets from muted and blocked users")
  @query
  excludeMutedAndBlocked?: boolean;
}

model RegisterStartBody {
  name: string;
  email: string;
  birthDate: plainDate; // ISO 8601 date format (YYYY-MM-DD)
  recaptchaToken: string; // token from client side recaptcha v2
}

model DataResponse<T> {
  ...OkResponse;
  ...Body<ApiSuccessResponse<T>>;
}

model DataResponseWithPagination<T> {
  ...OkResponse;
  ...Body<ApiSuccessResponseWithPagination<T>>;
}

model MessageResponse<TMessage extends string> {
  ...OkResponse;
  ...Body<{
    success: true;
    message?: TMessage; // optional message field on success
  }>;
}

model MessageCreatedResponse<TMessage extends string> {
  ...CreatedResponse;
  ...Body<{
    success: true;
    message?: TMessage; // optional message field on success
  }>;
}

model FollowingUser {
  ...CompactUser;
  isFollowing: boolean;
  followsYou: boolean;
  isBlocked: boolean;
}

model AccountInfo {
  username: string;
  email: string | null;
  accountCreationDate: utcDateTime; // ISO 8601 format (e.g., '2024-01-15T14:30:00Z')
  accountCreationIp: string | null;
  country: string;
  languages: LanguageCode[];
  gender: Gender;
  birthDate: plainDate; // ISO 8601 date format (YYYY-MM-DD)
  age: int32;
}

enum LanguageCode {
  AR,
  EN,
}

enum Gender {
  Male,
  Female,
}

enum InterestCode {
  CULTURE,
  FINANCE,
  MEDICAL,
  POLITICS,
  SPORTS,
  TECH,
  ENTERTAINMENT,
  GENERAL,
  FOOD,
  LEARNING,
  TRAVEL,
}

alias FollowingListResponse = DataResponseWithPagination<FollowingUser[]>;
alias FollowersListResponse = DataResponseWithPagination<FollowingUser[]>;
alias BlockedListResponse = DataResponseWithPagination<CompactUser[]>;
alias MutedListResponse = DataResponseWithPagination<CompactUser[]>;
alias SessionListResponse = DataResponse<SessionResponse[]>;
alias NotificationsListResponse = DataResponseWithPagination<Notification[]>;

alias UnfollowUserResponse = MessageResponse<"user unfollowed successfully">;
alias FollowUserResponse = MessageResponse<"user followed successfully">;
alias BlockUserResponse = MessageResponse<"user blocked successfully">;
alias UnblockUserResponse = MessageResponse<"user unblocked successfully">;
alias MuteUserResponse = MessageResponse<"user muted successfully">;
alias UnmuteUserResponse = MessageResponse<"user unmuted successfully">;

// Conversation and Messages response aliases
alias ConversationListResponse = DataResponseWithPagination<Conversation[]>;
alias MessageListResponse = DataResponseWithPagination<{
  participant: UserMetadataWithLastSeen;
  messages: Message[];
}>;
alias ConversationResponse = DataResponse<Conversation>;
alias ConversationMessageResponse = DataResponse<Message>;
alias MuteConversationResponse = MessageResponse<"Conversation muted successfully">;
alias UnmuteConversationResponse = MessageResponse<"Conversation unmuted successfully">;
alias DeleteMessageResponse = MessageResponse<"Message deleted successfully">;

@tag("Auth")
@route("/auth")
namespace Auth {
  @route("/register")
  namespace Register {
    @post
    @route("/start")
    op startRegister(@body body: RegisterStartBody):
      | DataResponse<{
          creationToken: string;
        }>
      | ValidationErrorResponse
      | ConflictResponse
      | RateLimitResponse
      | InternalServerErrorResponse;

    @post
    @route("/verify")
    op verifyRegister(
      @body body: {
        creationToken: string;
        otp: string;
      },
    ):
      | MessageResponse<"Registration verified successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | InternalServerErrorResponse;

    @post
    @route("/resend-otp")
    op resendOtp(
      @body body: {
        creationToken: string;
      },
    ):
      | MessageResponse<"otp resent successfully.">
      | BadRequestResponse
      | RateLimitResponse
      | InternalServerErrorResponse;

    @post
    @summary("Complete the registration process by setting a password")
    @route("/complete")
    op completeRegister(
      @header("X-Client-Type") clientType: "web" | "mobile",
      @body body: {
        creationToken: string;
        password: string;
      },
    ):
      | DataResponse<{
          accessToken: string;
          refreshToken: string;
        }>
      | BadRequestResponse
      | ValidationErrorResponse
      | InternalServerErrorResponse;
  }

  @post
  @route("/login")
  op login(
    @header("X-Client-Type") clientType: "web" | "mobile",
    @body body: {
      identifier: string;
      password: string;
    },
  ):
    | (DataResponse<{
        accessToken: string;
        refreshToken: string;
      }> &
        SetAuthCookieResponse)
    | ValidationErrorResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @post
  @route("/logout")
  @doc("refresh token is required in cookie from web clints and in body from mobile clients")
  @summary("refresh token is required in cookie from web clints and in body from mobile clients")
  @useAuth(BearerAuth)
  op logout(
    @header("X-Client-Type") clientType: "web" | "mobile",
    @cookie("refreshToken") refreshToken?: string,
    @body body?: {
      refreshToken: string;
      fcmToken?: string;
    },
  ): MessageResponse<"Logged out successfully."> | UnauthorizedResponse | InternalServerErrorResponse;

  @post
  @route("/refresh-token")
  @doc("refresh token is required in cookie from web clints and in body from mobile clients")
  @summary("refresh token is required in cookie from web clints and in body from mobile clients")
  op refreshToken(
    @header("X-Client-Type") clientType: "web" | "mobile",
    @cookie("refreshToken") refreshToken?: string,
    @body body?: {
      refreshToken: string;
    },
  ):
    | DataResponse<{
        accessToken: string;
        refreshToken: string;
      }>
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @route("/password")
  namespace Password {
    @post
    @route("/forgot")
    @summary("Initiate the password reset process")
    op forgotPassword(
      @body body: {
        identifier: string;
        recaptchaToken: string; // token from client side recaptcha v2
      },
    ):
      | DataResponse<{
          confirmationToken: string;
        }>
      | ValidationErrorResponse
      | NotFoundResponse
      | RateLimitResponse
      | InternalServerErrorResponse
      | BadRequestResponse;

    @post
    @route("/forgot/verify")
    @summary("Verify the OTP for password reset")
    op verifyForgotPassword(
      @body body: {
        confirmationToken: string;
        otp: string;
      },
    ):
      | MessageResponse<"Password reset verified successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | InternalServerErrorResponse;

    @post
    @route("/reset")
    @summary("Reset the password using the confirmation token")
    op resetPassword(
      @body body: {
        confirmationToken: string;
        newPassword: string;
      },
    ):
      | MessageResponse<"Password has been reset successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | InternalServerErrorResponse;

    @post
    @route("/resend-otp")
    @summary("Resend the OTP for password reset")
    op resendOtpPassword(
      @body body: {
        confirmationToken: string;
      },
    ):
      | MessageResponse<"OTP resent successfully.">
      | BadRequestResponse
      | RateLimitResponse
      | InternalServerErrorResponse;
  }

  @get
  @summary("Check if a username or email is already taken")
  @doc("""
    This endpoint checks whether a given identifier (username or email) is already taken in the system.
    to be used in login in shared field which can be either username or email.
    """)
  @route("/check-identifier")
  op checkIdentifier(@query identifier: string): DataResponse<{
    exists: boolean;
    type: "username" | "email";
  }> | ValidationErrorResponse | InternalServerErrorResponse;

  @get
  @summary("Check if a email is already taken")
  @doc("""
    This endpoint checks whether a given email is already taken in the system.
    """)
  @route("/check-email")
  op checkEmail(@query email: string): DataResponse<{
    exists: boolean;
  }> | ValidationErrorResponse | InternalServerErrorResponse;

  @get
  @summary("Check if a username is already taken")
  @doc("""
    This endpoint checks whether a given username is already taken in the system.
    """)
  @route("/check-username")
  @useAuth(BearerAuth)
  op checkUsername(@query username: string):
    | DataResponse<{
        exists: boolean;
      }>
    | ValidationErrorResponse
    | InternalServerErrorResponse
    | UnauthorizedResponse
    | NotFoundResponse;
}

@tag("OAuth")
@route("/oauth")
namespace Oauth {
  @post
  @route("/{provider}/callback")
  @summary("Handle OAuth callback for a given provider")
  @doc("""
    This endpoint handles OAuth callbacks from providers. It can return two types of responses:
    
    1. **New User (Registration Required)**: Returns a `creationToken` that must be used with the `/complete` endpoint to finish registration by providing birth date.
       Example response: `{ "success": true, "data": { "creationToken": "bGxxkpXVCJ9..." } }`
    
    2. **Existing User (Login)**: Returns `accessToken` and `refreshToken` for immediate authentication.
       Example response: `{ "success": true, "data": { "accessToken": "bGxxkpXVCJ9...", "refreshToken": "dxxG9rZW4..." } }`
    """)
  op handleOauthCallback(
    @header("X-Client-Type") clientType: "web" | "mobile",
    @path provider: string,
    @body body: {
      providerToken: string;
    },
  ):
    | DataResponse<{
        creationToken: string;
        accessToken?: never;
        refreshToken?: never;
      } | {
        creationToken?: never;
        accessToken: string;
        refreshToken: string;
      }>
    | BadRequestResponse
    | ValidationErrorResponse
    | InternalServerErrorResponse;

  @post
  @route("/complete")
  @summary("Complete OAuth registration by sending the birth data")
  op completeOauthRegister(
    @header("X-Client-Type") clientType: "web" | "mobile",
    @body body: {
      creationToken: string;
      birthDate: plainDate; // ISO 8601 date format (YYYY-MM-DD)
    },
  ):
    | DataResponse<{
        accessToken: string;
        refreshToken: string;
      }>
    | BadRequestResponse
    | ValidationErrorResponse
    | InternalServerErrorResponse;

  @get
  @route("/{provider}/bridge")
  @summary("OAuth bridge endpoint for handling provider redirects")
  @doc("""
    This endpoint acts as a bridge between OAuth providers and the client application.
    
    **Redirect URL format(Sent back to client):**
    All fields are optional except provider.
    `{redirect}?provider={provider}&code={code}&error={error}&errorDescription={errorDescription}`
    
    **State parameter format (base64 encoded JSON):**
    ```json
    {
      "redirect": "https://app.example.com/oauth?provider=google&code=200&error=err&errorDescription=errordescription"
    }
    ```
    """)
  op getProviderBridge(
    @path provider: string,
    @query code?: string,
    @query error?: string,
    @query errorDescription?: string,
    @query state: string,
  ):
    | Response<302> // redirect response
    | BadRequestResponse
    | ValidationErrorResponse
    | InternalServerErrorResponse;
}

@tag("Users")
@route("/users")
@useAuth(BearerAuth)
namespace Users {
  @summary("Get a user's profile preview.")
  @get
  @route("/{username}/preview")
  op getUserPreview(@path username: string):
    | DataResponse<UserPreview>
    | UnauthorizedResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @summary("User's profile details")
  @get
  @route("/{username}/profile")
  op getUserProfile(
    @path username: string,
  ): DataResponse<UserProfile> | NotFoundResponse | InternalServerErrorResponse;

  @summary("List user's tweets")
  @get
  @route("/{username}/tweets")
  op getUserTweets(@path username: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<Tweet[]>
    | UnauthorizedResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @summary("List user's replies and tweets")
  @get
  @route("/{username}/replies")
  op getUserReplies(@path username: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<TweetWithReplyTo[]>
    | UnauthorizedResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @summary("List user's liked tweets")
  @get
  @route("/{username}/likes")
  op getUserLikes(@path username: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<Tweet[]>
    | UnauthorizedResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @summary("List user's tweets with media attachments")
  @get
  @route("/{username}/media")
  op getUserMedia(@path username: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<Tweet[]>
    | UnauthorizedResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  namespace Follows {
    @summary("List a user's followers")
    @get
    @route("/{username}/followers")
    op listUserFollowers(@path username: string, ...CursorPaginationParameters):
      | FollowersListResponse
      | NotFoundResponse
      | BadRequestResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @get
    @route("/{username}/mutual")
    @summary("List mutual followers with a user given their username")
    op listMutualFollowers(@path username: string, ...CursorPaginationParameters):
      | FollowersListResponse
      | BadRequestResponse
      | NotFoundResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @route("/{username}/following")
    namespace Following {
      @summary("List users a user is following")
      @get
      op listUserFollowing(@path username: string, ...CursorPaginationParameters):
        | FollowingListResponse
        | BadRequestResponse
        | NotFoundResponse
        | UnauthorizedResponse
        | InternalServerErrorResponse;

      @summary("Follow a user")
      @post
      op followUser(
        @path
        username: string,
      ):
        | FollowUserResponse
        | NotFoundResponse
        | ConflictResponse
        | UnauthorizedResponse
        | ForbiddenResponse
        | InternalServerErrorResponse;

      @summary("Unfollow a user")
      @delete
      op unfollowUser(
        @path
        username: string,
      ):
        | UnfollowUserResponse
        | NotFoundResponse
        | BadRequestResponse
        | UnauthorizedResponse
        | InternalServerErrorResponse;
    }
  }

  @summary("enable notifications for a user, follows the user if not followed")
  @post
  @route("{username}/notify")
  op enableUserNotifications(@path username: string):
    | MessageResponse<"Notifications enabled for user successfully.">
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @summary("disable notifications for a user, follows the user if not followed")
  @delete
  @route("{username}/notify")
  op disableUserNotifications(@path username: string):
    | MessageResponse<"Notifications disabled for user successfully.">
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;
}

@tag("Me")
@route("/me")
@useAuth(BearerAuth)
namespace Me {
  @get
  @summary("Get the authenticated user's profile")
  op getMyProfile(): DataResponse<UserProfile> | UnauthorizedResponse | InternalServerErrorResponse;

  @patch(#{ implicitOptionality: true })
  @summary("Update the authenticated user's profile")
  op updateMyProfile(@body body: UpdateProfileRequest):
    | DataResponse<UpdatedProfile>
    | ValidationErrorResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @put
  @route("/password")
  @summary("Change the authenticated user's password")
  op changeMyPassword(
    @body body: {
      currentPassword: string;
      newPassword: string;
    },
  ):
    | MessageResponse<"Password changed successfully.">
    | UnauthorizedResponse
    | ValidationErrorResponse
    | InternalServerErrorResponse;

  @post
  @route("/profile-picture")
  op updateProfilePicture(
    @header contentType: "multipart/form-data",
    @multipartBody body: {
      profilePicture: HttpPart<File>;
    },
  ):
    | MessageResponse<"Profile picture updated successfully.">
    | ValidationErrorResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @post
  @route("phone")
  op addPhoneNumber(
    @body body: {
      phoneNumber: string;
      recaptchaToken: string; // token from client side recaptcha v2
    },
  ):
    | MessageResponse<"Phone number added successfully. Verification code sent via SMS.">
    | ValidationErrorResponse
    | ConflictResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @post
  @route("/banner")
  op updateBanner(
    @header contentType: "multipart/form-data",
    @multipartBody body: {
      banner: HttpPart<File>;
    },
  ):
    | DataResponse<{
        bannerUrl: string;
      }>
    | ValidationErrorResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @delete
  @route("/banner")
  op deleteBanner(
  ): MessageResponse<"Banner deleted successfully."> | UnauthorizedResponse | InternalServerErrorResponse;

  @post
  @summary("Deactivate or delete the authenticated user's account.")
  op deactivateAccount(
    @body body: {
      currentPassword: string;
    },
  ):
    | MessageResponse<"Account deactivated successfully. You have been logged out.">
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;
  @useAuth(BearerAuth)
  @route("/settings")
  namespace Settings {
    @summary("Validate the current user's password")
    @doc("This endpoint allows an already authenticated user to verify their password. It is used in order to show account info in the settings page.")
    @useAuth(BearerAuth)
    @post
    @route("password/validate")
    op validatePassword(
      @body body: {
        password: string;
      },
    ):
      | DataResponse<{
          isValid: boolean;
        }>
      | UnauthorizedResponse
      | ForbiddenResponse
      | ValidationErrorResponse
      | InternalServerErrorResponse;

    @summary("Get the authenticated user's account information")
    @doc("Retrieves detailed profile and account settings for the currently authenticated user, identified by their JWT.")
    @get
    op getAccountInfo():
      | DataResponse<AccountInfo>
      | UnauthorizedResponse
      | InternalServerErrorResponse
      | ForbiddenResponse;

    @patch(#{ implicitOptionality: false })
    @route("/username")
    @summary("Change the authenticated user's username")
    op updateUsername(
      @body body: {
        newUsername: string;
      },
    ):
      | MessageResponse<"Username changed successfully.">
      | ValidationErrorResponse
      | NotFoundResponse
      | ConflictResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @put
    @route("/email")
    @summary("Initiates update of the authenticated user's email address")
    op updateEmail(
      @body body: {
        newEmail: string;
      },
    ):
      | DataResponse<{
          confirmationToken: string;
        }>
      | ValidationErrorResponse
      | ConflictResponse
      | NotFoundResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @post
    @route("/email/resend-otp")
    @summary("Resend the verification code to the new email address")
    op resendEmailVerificationOtp(
      @body body: {
        confirmationToken: string;
      },
    ):
      | MessageResponse<"Verification code resent successfully.">
      | BadRequestResponse
      | RateLimitResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse
      | ValidationErrorResponse;

    @post
    @route("/email/verify")
    @summary("Verify the new email address using the code sent to the new email, invalidates SSOs using the same email")
    op verifyNewEmail(
      @body body: {
        confirmationToken: string;
        otp: string;
      },
    ):
      | MessageResponse<"Email address updated successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @put
    @route("/country")
    @summary("Update the authenticated user's country")
    op updateCountry(
      @body body: {
        countryName: string;
      },
    ):
      | MessageResponse<"Country updated successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @put
    @route("/gender")
    @summary("Update the authenticated user's gender")
    op updateGender(
      @body body: {
        gender: Gender;
      },
    ):
      | MessageResponse<"Gender updated successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @put
    @route("/birthdate")
    @summary("Update the authenticated user's birth date")
    op updateBirthDate(
      @body body: {
        date: plainDate | null; // ISO 8601 date format (YYYY-MM-DD)
      },
    ):
      | MessageResponse<"Birth date updated successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @put
    @route("/language")
    @summary("Update the authenticated user's default language")
    op updateLanguage(
      @body body: {
        language: LanguageCode;
      },
    ):
      | MessageResponse<"Default language updated successfully.">
      | BadRequestResponse
      | ValidationErrorResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @summary("List a user's blocks")
    @get
    @route("/blocks")
    op listUserBlocks(
      ...CursorPaginationParameters,
    ): BlockedListResponse | UnauthorizedResponse | InternalServerErrorResponse;

    @summary("List a user's mutes")
    @get
    @route("/mutes")
    op listUserMutes(
      ...CursorPaginationParameters,
    ): MutedListResponse | UnauthorizedResponse | InternalServerErrorResponse;

    @get
    @route("/sessions")
    @summary("Retrieve all active and recent sessions for the authenticated user.")
    op getSessions(): SessionListResponse | UnauthorizedResponse | InternalServerErrorResponse;

    @delete
    @route("/sessions/{sessionId}")
    @summary("Log out or terminate a specific session by its ID.")
    op deleteSession(@path sessionId: string):
      | MessageResponse<"Session terminated successfully.">
      | NotFoundResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;

    @get
    @route("/connected-accounts")
    @summary("Retrieve a list of all external social accounts connected for login.")
    op getConnectedAccounts(
    ): DataResponse<ConnectedAccountResponse[]> | UnauthorizedResponse | InternalServerErrorResponse;

    @post
    @route("/connected-accounts/{provider}")
    @summary("Disconnect an external social account by its provider (e.g., 'google', 'github').")
    op disconnectAccount(
      @path provider: string,
      @body body: {
        currentPassword: string;
      },
    ):
      | MessageResponse<"Account disconnected successfully.">
      | BadRequestResponse
      | UnauthorizedResponse
      | NotFoundResponse
      | InternalServerErrorResponse;

    @get
    @route("/country")
    @summary("Get all supported countries(for country selection dropdowns)")
    op getSupportedCountries(
    ): DataResponse<Country[]> | InternalServerErrorResponse | UnauthorizedResponse;

    @get
    @route("/interests")
    @summary("Get all available interests with user selection status")
    @doc("Returns a list of all available interests. Each interest includes a flag indicating whether the authenticated user has selected it.")
    op getInterests():
      | DataResponse<Interest[]>
      | UnauthorizedResponse
      | NotFoundResponse
      | InternalServerErrorResponse;

    @put
    @route("/interests")
    @summary("Update the authenticated user's interests")
    @doc("Replaces the user's entire interest list. The user must select at least one interest. Duplicates are automatically removed.")
    op updateInterests(
      @body body: {
        @doc("Array of interest codes the user wants to select")
        interests: InterestCode[];
      },
    ):
      | MessageResponse<"Interests updated successfully.">
      | ValidationErrorResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;
  }

  @route("/blocks")
  @useAuth(BearerAuth)
  namespace Blocks {
    @summary("Block a user")
    @post
    @route("/{username}")
    op blockUser(
      @path
      username: string,
    ):
      | BlockUserResponse
      | NotFoundResponse
      | ConflictResponse
      | UnauthorizedResponse
      | ForbiddenResponse
      | InternalServerErrorResponse;

    @summary("Unblock a user")
    @delete
    @route("/{username}")
    op unblockUser(
      @path
      username: string,
    ):
      | UnblockUserResponse
      | NotFoundResponse
      | BadRequestResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;
  }

  @route("/mutes")
  @useAuth(BearerAuth)
  namespace Mutes {
    @summary("Mute a user")
    @post
    @route("/{username}")
    op muteUser(
      @path
      username: string,
    ):
      | MuteUserResponse
      | NotFoundResponse
      | ConflictResponse
      | UnauthorizedResponse
      | ForbiddenResponse
      | InternalServerErrorResponse;

    @summary("Unmute a user")
    @delete
    @route("/{username}")
    op unmuteUser(
      @path
      username: string,
    ):
      | UnmuteUserResponse
      | NotFoundResponse
      | BadRequestResponse
      | UnauthorizedResponse
      | InternalServerErrorResponse;
  }
}

@tag("Timeline")
@route("/timeline")
@useAuth(BearerAuth)
namespace Timeline {
  @get
  @route("/for-you")
  @summary("Get the personalized 'For You' feed for the authenticated user")
  op getForYouFeed(
    ...CursorPaginationParameters,
  ): DataResponseWithPagination<Tweet[]> | UnauthorizedResponse | InternalServerErrorResponse | GoneResponse;

  @get
  @route("/following")
  @summary("Get tweets from users the authenticated user follows")
  op getFollowingFeed(
    ...CursorPaginationParameters,
  ): DataResponseWithPagination<Tweet[]> | UnauthorizedResponse | InternalServerErrorResponse;
}

@tag("Notifications")
@route("/notifications")
@useAuth(BearerAuth)
namespace Notifications {
  @get
  op listUserNotifications(
    ...CursorPaginationParameters,

    @query
    @doc("Filters the notifications by a specific category.")
    filter?: NotificationFilter,
  ):
    | NotificationsListResponse
    | BadRequestResponse
    | ValidationErrorResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @get
  @route("/count")
  @doc("Get the count of unseen notifications")
  op getNotificationsCount(): DataResponse<{
    unseenCount: integer;
  }> | UnauthorizedResponse | InternalServerErrorResponse;

  @patch
  @route("/seen")
  @doc("Mark all notifications as seen")
  op markAllNotificationsAsSeen(): DataResponse<{
    updatedCount: integer;
  }> | UnauthorizedResponse | InternalServerErrorResponse;

  @patch
  @route("/{notificationId}/seen")
  @doc("Mark a specific notification as seen by its ID")
  op markNotificationAsSeen(@path notificationId: string):
    | DataResponse<{
        updatedCount: integer;
      }>
    | UnauthorizedResponse
    | NotFoundResponse
    | ValidationErrorResponse
    | BadRequestResponse
    | InternalServerErrorResponse;
}

@tag("Tweets")
@route("/tweets")
@useAuth(BearerAuth)
namespace Tweets {
  @post
  @summary("Create a new tweet")
  op postTweet(@body body: TweetBody):
    | (Response<201> & Body<ApiSuccessResponse<TweetWithReplyTo>>)
    | ValidationErrorResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse
    | ConflictResponse
    | RateLimitResponse;

  @get
  @route("/{id}")
  @summary("Get a specific tweet by ID with its thread context")
  op getTweet(@path id: string):
    | DataResponse<TweetWithThread>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @get
  @route("/{id}/replies")
  @summary("Get replies to a specific tweet")
  op getTweetReplies(@path id: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<TweetWithoutQuotedTweet[]>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @get
  @route("/{id}/summary")
  @summary("Get AI-generated summary of a tweet")
  @doc("Generates a concise summary of the tweet content using AI")
  op getTweetSummary(
    @path id: string,

    @query
    @doc("Language locale for the summary (ar-EG for Arabic, en-US for English). Defaults to en-US if not provided.")
    locale?: "ar-EG" | "en-US",
  ):
    | DataResponse<TweetSummaryResponse>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @get
  @route("/{id}/quotes")
  @summary("Get quotes to a specific tweet")
  op getTweetQuotes(@path id: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<Tweet[]>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @get
  @route("/{id}/retweets")
  @summary("Get users who retweeted a tweet")
  op getTweetRetweeters(@path id: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<UserMetadataWithBio[]>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @get
  @route("/{id}/likes")
  @summary("Get users who liked my tweet")
  op getTweetLikes(@path id: string, ...CursorPaginationParameters):
    | DataResponseWithPagination<UserMetadataWithFollowInfo[]>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @post
  @route("/{id}/like")
  @summary("Like a tweet")
  op likeTweet(@path id: string):
    | MessageResponse<"Tweet liked successfully.">
    | NotFoundResponse
    | ConflictResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @delete
  @route("/{id}/like")
  @summary("Unlike a tweet")
  op unlikeTweet(@path id: string):
    | MessageResponse<"Tweet unliked successfully.">
    | NotFoundResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @post
  @route("/{id}/retweet")
  @summary("Retweet a tweet")
  op retweetTweet(@path id: string):
    | MessageResponse<"Tweet retweeted successfully.">
    | NotFoundResponse
    | ConflictResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @delete
  @route("/{id}/retweet")
  @summary("Undo retweet")
  op unretweetTweet(@path id: string):
    | MessageResponse<"Retweet undone successfully.">
    | NotFoundResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @delete
  @route("/{id}")
  @summary("Delete a tweet")
  op deleteTweet(@path id: string):
    | MessageResponse<"Tweet deleted successfully.">
    | NotFoundResponse
    | UnauthorizedResponse
    | ForbiddenResponse
    | InternalServerErrorResponse;
}

@tag("Onboarding")
@route("/onboarding")
@useAuth(BearerAuth)
namespace Onboarding {
  @get
  @route("/username-suggestions")
  @summary("Get username suggestions for the authenticated user")
  @doc("""
    Generates username suggestions based on either:
    - User's display name (default): If 'typed' parameter is not provided
    - Custom input: If 'typed' parameter is provided, suggestions are generated from that input
    
    The endpoint will generate up to 3 username suggestions that are available (not taken by other users).
    """)
  op getUsernameSuggestions(
    @query
    @doc("Optional custom text to generate usernames from. If provided, suggestions will be based on this input instead of the user's display name.")
    typed?: string,
  ): DataResponse<{
    suggestions: string[];
  }> | UnauthorizedResponse | InternalServerErrorResponse;

  @get
  @route("/follow-suggestions")
  @summary("Get follow suggestions for the authenticated user")
  @doc("""
    **Suggestion Algorithm:**
    - Prioritizes users with mutual followers (friends of friends)
    - Secondary sorting by follower count (popularity)
    - Excludes blocked or blockedby, muted, and already-followed users
    
    **Parameters:**
    - `limit` (optional): Number of suggestions to return (max 15, default 15)
    
    **Not Paginated:** This endpoint returns a fixed set of suggestions and does not support cursor-based pagination.
    """)
  op getFollowSuggestions(
    @query
    @doc("Maximum number of suggestions to return. Capped at 15. Defaults to 15 if not provided.")
    limit?: int32,
  ): DataResponse<{
    suggestions: FollowSuggestionData[];
  }> | UnauthorizedResponse | InternalServerErrorResponse;
}

@tag("Conversations")
@route("/conversations")
@useAuth(BearerAuth)
namespace Conversations {
  @get
  @summary("List all conversations for the authenticated user")
  @doc("""
    Retrieves a paginated list of all 1:1 conversations for the authenticated user,
    ordered by most recent activity (last message timestamp).
    Each conversation includes its ID, so clients can use the ID for subsequent operations.
    """)
  op listConversations(
    ...CursorPaginationParameters,
  ): ConversationListResponse | UnauthorizedResponse | InternalServerErrorResponse;

  @post
  @route("/with/{username}")
  @summary("Create or retrieve a 1:1 conversation with a user by username")
  @doc("""
    Creates a new 1:1 conversation with the specified user, or returns the existing one.
    Returns the conversation with its ID, which should be used for all subsequent operations.
    
    **Use this endpoint when:**
    - User clicks "Message" button on someone's profile
    - Initializing a conversation for the first time
    
    **After receiving the conversation ID, use ID-based endpoints for:**
    - Fetching messages: GET /conversations/{id}/messages
    - Sending messages: POST /conversations/{id}/messages
    - Muting/unmuting: POST/DELETE /conversations/{id}/mute
    """)
  op createOrGetConversationByUsername(@path username: string):
    | ConversationResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @get
  @route("/{conversationId}/messages")
  @summary("List messages in a conversation by ID")
  @doc("""
    Retrieves paginated messages using conversation ID.
    Messages are ordered by creation time (newest first).
    Soft-deleted messages (for the current user) are filtered out.
    """)
  op getMessages(@path conversationId: string, ...CursorPaginationParameters):
    | MessageListResponse
    | UnauthorizedResponse
    | ForbiddenResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @get
  @route("/unseen-count")
  @summary("Get the count of conversations with unseen messages")
  op getUnseenCounts(): DataResponse<{
    count: integer;
  }> | UnauthorizedResponse | InternalServerErrorResponse;

  @delete
  @route("/{conversationId}/messages/{messageId}")
  @summary("Soft-delete a message by IDs")
  @doc("""
    Soft-deletes a message using conversation ID and message ID.
    Sets is_deleted_sender or is_deleted_receiver flag based on user role.
    """)
  op deleteMessage(@path conversationId: string, @path messageId: string):
    | DeleteMessageResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | ForbiddenResponse
    | NotFoundResponse
    | InternalServerErrorResponse;

  @post
  @route("/{conversationId}/mute")
  @summary("Mute a conversation by ID")
  @doc("""
    Mutes notifications for a conversation using its ID.
    """)
  op muteConversation(@path conversationId: string):
    | MuteConversationResponse
    | UnauthorizedResponse
    | ForbiddenResponse
    | NotFoundResponse
    | ConflictResponse
    | InternalServerErrorResponse;

  @delete
  @route("/{conversationId}/mute")
  @summary("Unmute a conversation by ID")
  @doc("""
    Unmutes notifications for a conversation using its ID.
    """)
  op unmuteConversation(@path conversationId: string):
    | UnmuteConversationResponse
    | BadRequestResponse
    | UnauthorizedResponse
    | ForbiddenResponse
    | NotFoundResponse
    | InternalServerErrorResponse;
}

@tag("Search")
@route("/search")
@useAuth(BearerAuth)
namespace Search {
  @summary("Get top 3 relevant trending words for the current search query (If it contains #), or suggested hashtags whilst typing anyform of a post")
  @get
  @route("/suggestions")
  op getTopHashtags(
    @doc("The search query")
    @query
    query: string,
  ): DataResponse<string[]> | NotFoundResponse | UnauthorizedResponse | InternalServerErrorResponse;

  @summary("Get suggested users from following/follower list, used in mentions")
  @get
  @route("/users/suggestions")
  op getUserSuggestions(
    @doc("Search query (username or display name)")
    @query
    query: string,

    ...CursorPaginationParameters,
  ):
    | DataResponseWithPagination<{
        users: UserMetadataWithFollowInfo[];
      }>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @summary("Get all users matching the search query - returns paginated user results")
  @get
  @route("/users")
  op searchUsers(
    @doc("Search query (username or display name)")
    @query
    query: string,

    ...CursorPaginationParameters,
  ):
    | DataResponseWithPagination<{
        users: SearchUser[];
      }>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;

  @summary("Search for tweets (Posts/Latest tab) - returns paginated tweet results")
  @doc("Supports searching by a normal text or hashtags")
  @get
  @route("/tweets")
  op searchTweets(...SearchTweetsParameters, ...CursorPaginationParameters):
    | DataResponseWithPagination<TweetWithReplyTo[]>
    | NotFoundResponse
    | UnauthorizedResponse
    | InternalServerErrorResponse;
}

