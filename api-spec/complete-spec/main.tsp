@tag("Hashtags")
@useAuth(BearerAuth)
@route("/hashtags")
namespace Hashtags {
  @get
  @route("/suggestions")
  @summary("Get suggested hashtags based on trending topics")
  @doc("Returns a list of suggested hashtags based on current trends and the user's interests.")
  op getHashtagSuggestions(
    @query
