generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       BigInt                    @id @default(autoincrement())
  username                 String                    @unique @db.Citext
  email                    String                    @unique @db.Citext
  passwordHash             String?                   @map("password_hash")
  birthdate                DateTime                  @db.Date
  phone                    String?                   @unique @db.VarChar(20)
  createdAt                DateTime                  @default(now()) @map("created_at")
  languageCode             LanguageCode              @default(EN) @map("language_code")
  deletedAt                DateTime?                 @map("deleted_at")
  blockedBy                Block[]                   @relation("blocks_blocked_idTousers")
  blockedUsers             Block[]                   @relation("blocks_user_idTousers")
  conversationParticipants ConversationParticipant[]
  createdConversations     Conversation[]            @relation("conversations_creator_idTousers")
  followers                Follow[]                  @relation("follows_followed_idTousers")
  following                Follow[]                  @relation("follows_follower_idTousers")
  likes                    Like[]
  media                    Media[]
  messages                 Message[]
  mutedBy                  Mute[]                    @relation("mutes_muted_idTousers")
  mutedUsers               Mute[]                    @relation("mutes_user_idTousers")
  sentNotifications        Notification[]            @relation("notifications_actor_idTousers")
  receivedNotifications    Notification[]            @relation("notifications_receiver_idTousers")
  profile                  Profile?
  refreshTokens            RefreshToken[]
  retweets                 Retweet[]
  countryId                Int?
  country                  Country?                  @relation(fields: [countryId], references: [id])
  tweetMentions            TweetMention[]
  tweets                   Tweet[]
  userDevices              UserDevice[]
  gender                   Gender?
  userExternalAccounts     UserExternalAccount[]

  @@map("users")
}

model Country {
  id    Int    @id @default(autoincrement())
  name  String
  code  String @unique
  users User[]

  @@map("countries")
}

model Profile {
  userId      BigInt   @id @map("user_id")
  displayName String   @map("display_name") @db.VarChar(100)
  bio         String?  @db.VarChar(160)
  bioEntities Json?    @map("bio_entities") @db.JsonB
  avatarUrl   String?  @map("avatar_url") @db.VarChar(255)
  bannerUrl   String?  @map("banner_url") @db.VarChar(255)
  location    String?  @db.VarChar(255)
  websiteUrl  String?  @map("website_url") @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("profiles")
}

model RefreshToken {
  id         BigInt     @id @default(autoincrement())
  deviceId   BigInt     @unique @map("device_id")
  userId     BigInt     @map("user_id")
  tokenHash  String     @unique @map("token_hash")
  expiresAt  DateTime   @map("expires_at")
  lastUsedAt DateTime?  @map("last_used_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  userDevice UserDevice @relation(fields: [deviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refresh_tokens")
}

model UserExternalAccount {
  provider       String   @db.VarChar(50)
  providerUserId String   @map("provider_user_id")
  userId         BigInt   @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([provider, providerUserId])
  @@unique([userId, provider], map: "user_external_accounts_user_id_provider_idx")
  @@map("user_external_accounts")
}

model UserDevice {
  id           BigInt        @id @default(autoincrement())
  userId       BigInt        @map("user_id")
  fcmToken     String?       @unique @map("fcm_token")
  ipAddress    String?       @map("ip_address") @db.Inet
  deviceType   String?       @map("device_type")
  lastUsedAt   DateTime      @default(now()) @map("last_used_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  refreshToken RefreshToken?
  user         User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_devices")
}

model Tweet {
  id             BigInt         @id @default(autoincrement())
  userId         BigInt         @map("user_id")
  content        String?        @db.VarChar(280)
  hasMedia       Boolean        @default(false) @map("has_media")
  hasHashtags    Boolean        @default(false) @map("has_hashtags")
  hasMentions    Boolean        @default(false) @map("has_mentions")
  replyToTweetId BigInt?        @map("reply_to_tweet_id")
  quotedTweetId  BigInt?        @map("quoted_tweet_id")
  likeCount      Int            @default(0) @map("like_count")
  retweetCount   Int            @default(0) @map("retweet_count")
  replyCount     Int            @default(0) @map("reply_count")
  isDeleted      Boolean        @default(false) @map("is_deleted")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  likes          Like[]
  notifications  Notification[]
  retweets       Retweet[]
  tweetHashtags  TweetHashtag[]
  tweetMedia     TweetMedia[]
  tweetMentions  TweetMention[]
  quotedTweet    Tweet?         @relation("tweets_quoted_tweet_idTotweets", fields: [quotedTweetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotes         Tweet[]        @relation("tweets_quoted_tweet_idTotweets")
  replyToTweet   Tweet?         @relation("tweets_reply_to_tweet_idTotweets", fields: [replyToTweetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Tweet[]        @relation("tweets_reply_to_tweet_idTotweets")
  user           User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([replyToTweetId], map: "tweets_reply_to_tweet_id_idx")
  @@index([quotedTweetId], map: "tweets_quoted_tweet_id_idx")
  @@index([userId, createdAt], map: "tweets_user_id_created_at_idx")
  @@map("tweets")
}

model Block {
  userId      BigInt   @map("user_id")
  blockedId   BigInt   @map("blocked_id")
  createdAt   DateTime @default(now()) @map("created_at")
  blockedUser User     @relation("blocks_blocked_idTousers", fields: [blockedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blocker     User     @relation("blocks_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, blockedId])
  @@map("blocks")
}

model Mute {
  userId    BigInt   @map("user_id")
  mutedId   BigInt   @map("muted_id")
  createdAt DateTime @default(now()) @map("created_at")
  mutedUser User     @relation("mutes_muted_idTousers", fields: [mutedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  muterUser User     @relation("mutes_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, mutedId])
  @@map("mutes")
}

model Follow {
  followerId        BigInt   @map("follower_id")
  followedId        BigInt   @map("followed_id")
  createdAt         DateTime @default(now()) @map("created_at")
  withNotifications Boolean  @default(false) @map("with_notifications")
  followedUser      User     @relation("follows_followed_idTousers", fields: [followedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  followerUser      User     @relation("follows_follower_idTousers", fields: [followerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([followerId, followedId])
  @@index([followedId, followerId])
  @@map("follows")
}

model Retweet {
  userId    BigInt   @map("user_id")
  tweetId   BigInt   @map("tweet_id")
  createdAt DateTime @default(now()) @map("created_at")
  tweet     Tweet    @relation(fields: [tweetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, tweetId])
  @@index([tweetId])
  @@index([userId, createdAt], map: "retweets_user_id_created_at_idx")
  @@map("retweets")
}

model Like {
  userId    BigInt   @map("user_id")
  tweetId   BigInt   @map("tweet_id")
  createdAt DateTime @default(now()) @map("created_at")
  tweet     Tweet    @relation(fields: [tweetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, tweetId])
  @@index([tweetId, userId])
  @@map("likes")
}

model TrendingKeyword {
  id            BigInt         @id @default(autoincrement())
  keyword       String         @db.VarChar(100)
  category      Categories?
  lastUpdatedAt DateTime?      @map("last_updated_at")
  isHashtag     Boolean        @default(false) @map("is_hashtag")
  count         Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at")
  tweetHashtags TweetHashtag[]

  @@unique([keyword, isHashtag])
  @@map("trending_keywords")
}

model TweetHashtag {
  tweetId       BigInt          @map("tweet_id")
  hashtagId     BigInt          @map("hashtag_id")
  startPosition Int             @map("starting_index")
  hashtag       TrendingKeyword @relation(fields: [hashtagId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet         Tweet           @relation(fields: [tweetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([hashtagId, tweetId, startPosition])
  @@index([tweetId, hashtagId])
  @@map("tweet_hashtags")
}

model TweetMention {
  tweetId       BigInt @map("tweet_id")
  userId        BigInt @map("user_id")
  startPosition Int    @map("starting_index")
  tweet         Tweet  @relation(fields: [tweetId], references: [id])
  user          User   @relation(fields: [userId], references: [id])

  @@id([tweetId, userId])
  @@index([userId, tweetId])
  @@map("tweet_mentions")
}

model Message {
  id                          BigInt                    @id @default(autoincrement())
  userId                      BigInt                    @map("user_id")
  conversationId              BigInt                    @map("conversation_id")
  content                     String
  messageEntities             Json?                     @map("message_entities") @db.JsonB
  createdAt                   DateTime                  @default(now()) @map("created_at")
  conversationParticipants    ConversationParticipant[]
  conversationWithLastMessage Conversation?             @relation("conversations_last_message_idTomessages")
  conversation                Conversation              @relation("messages_conversation_idToconversations", fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                        User                      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mediaUrl                    String?                   @map("media_url")
  isDeletedSender             Boolean                   @default(false) @map("is_deleted_sender")
  isDeletedReceiver           Boolean                   @default(false) @map("is_deleted_receiver")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Conversation {
  id                       BigInt                    @id @default(autoincrement())
  creatorId                BigInt                    @map("creator_id")
  lastMessageId            BigInt?                   @unique @map("last_message_id")
  createdAt                DateTime                  @default(now()) @map("created_at")
  conversationParticipants ConversationParticipant[]
  creator                  User                      @relation("conversations_creator_idTousers", fields: [creatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lastMessage              Message?                  @relation("conversations_last_message_idTomessages", fields: [lastMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages                 Message[]                 @relation("messages_conversation_idToconversations")

  @@map("conversations")
}

model ConversationParticipant {
  conversationId     BigInt       @map("conversation_id")
  userId             BigInt       @map("user_id")
  lastSeenMessageId  BigInt?      @map("last_seen_message_id")
  notificationsMuted Boolean      @default(false) @map("notifications_muted")
  conversation       Conversation @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages           Message?     @relation(fields: [lastSeenMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user               User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([conversationId, userId], map: "conversation_participants_conversation_id_user_id_idx")
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model Notification {
  id            BigInt           @id @default(autoincrement())
  actorId       BigInt           @map("actor_id")
  receiverId    BigInt           @map("receiver_id")
  type          NotificationType
  tweetId       BigInt?          @map("tweet_id")
  dedupeKey     String?          @unique @map("dedupe_key") @db.VarChar(255)
  isAggregated  Boolean          @default(false) @map("is_aggregated")
  seen          Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at")
  openedAt      DateTime?        @map("opened_at")
  latestEventAt DateTime         @default(now()) @map("latest_event_at")
  actor         User             @relation("notifications_actor_idTousers", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver      User             @relation("notifications_receiver_idTousers", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet         Tweet?           @relation(fields: [tweetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiverId, createdAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             BigInt                     @id @default(autoincrement())
  notificationId BigInt                     @map("notification_id")
  deviceId       BigInt                     @map("device_id")
  fcmMessageId   String?                    @map("fcm_message_id")
  status         NotificationDeliveryStatus // queued|sent|failed|invalid_token
  responseBody   Json?
  attemptedAt    DateTime                   @default(now()) @map("attempted_at")

  @@index([notificationId])
  @@map("notification_deliveries")
}

model Media {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt       @map("user_id")
  type       MediaType
  url        String       @db.VarChar(255)
  altText    String?      @map("alt_text")
  width      Int?
  height     Int?
  pending    Boolean      @default(false)
  createdAt  DateTime     @default(now()) @map("created_at")
  user       User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweetMedia TweetMedia[]

  @@index([userId])
  @@map("media")
}

model TweetMedia {
  tweetId BigInt @map("tweet_id")
  mediaId BigInt @map("media_id")
  order   Int
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet   Tweet  @relation(fields: [tweetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tweetId, mediaId, order])
  @@map("tweet_media")
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
}

enum NotificationType {
  FOLLOW
  LIKE
  REPLY
  QUOTE
  RETWEET
  TWEET
  MENTION
  MESSAGE
}

enum LanguageCode {
  EN
  AR
}

enum Gender {
  FEMALE
  MALE
}

enum Categories {
  NEWS
  SPORTS
  ENTERTAINMENT
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  FAILED
  INVALID_TOKEN
}
