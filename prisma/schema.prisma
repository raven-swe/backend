// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                        BigInt                      @id @default(autoincrement())
  username                  String                      @unique @db.VarChar(50)
  email                     String                      @unique @db.VarChar(100)
  password_hash             String?
  birthdate                 DateTime                    @db.Date
  phone                     String?                     @db.VarChar(20)
  created_at                DateTime                    @default(now())
  language_code             LanguageCode                @default(EN)
  is_deleted                Boolean                     @default(false)
  blocked_by                blocks[]                    @relation("blocks_blocked_idTousers")
  blocked_users             blocks[]                    @relation("blocks_user_idTousers")
  conversation_participants conversation_participants[]
  followers                 follows[]                   @relation("follows_followed_idTousers")
  following                 follows[]                   @relation("follows_follower_idTousers")
  likes                     likes[]
  media                     media[]
  messages                  messages[]
  muted_by                  mutes[]                     @relation("mutes_muted_idTousers")
  muted_users               mutes[]                     @relation("mutes_user_idTousers")
  sent_notifications        notifications[]             @relation("notifications_actor_idTousers")
  received_notifications    notifications[]             @relation("notifications_receiver_idTousers")
  profile                   profiles?
  refresh_tokens            refresh_tokens[]
  retweets                  retweets[]
  tweets                    tweets[]
  user_devices              user_devices[]
  user_external_accounts    user_external_accounts[]
  tweet_mentions            tweet_mentions[]
}

model profiles {
  user_id      BigInt   @id
  display_name String   @db.VarChar(100)
  bio          String?  @db.VarChar(160)
  bio_entities Json?
  avatar_url   String?
  banner_url   String?
  location     String?
  website_url  String?
  updated_at   DateTime @updatedAt
  user         users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model refresh_tokens {
  id           BigInt    @id @default(autoincrement())
  device_id    BigInt    @unique
  user_id      BigInt
  token_hash   String    @unique
  expires_at   DateTime
  last_used_at DateTime?
  created_at   DateTime  @default(now())

  user_device user_devices @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        users        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model user_external_accounts {
  provider         String   @db.VarChar(50)
  provider_user_id String
  user_id          BigInt
  provider_email   String?  @db.VarChar(100)
  created_at       DateTime @default(now())
  user             users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([provider, provider_user_id])
  @@unique([user_id, provider], map: "user_external_accounts_user_id_provider_idx")
}

model user_devices {
  id            BigInt          @id @default(autoincrement())
  user_id       BigInt
  fcm_token     String          @unique
  ip_address    String?         @db.Inet
  device_type   String?
  last_used_at  DateTime
  created_at    DateTime        @default(now())
  refresh_token refresh_tokens?
  user          users           @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model tweets {
  id                BigInt           @id @default(autoincrement())
  user_id           BigInt
  content           String?          @db.VarChar(280)
  has_media         Boolean          @default(false)
  has_hashtags      Boolean          @default(false)
  has_mentions      Boolean          @default(false)
  reply_to_tweet_id BigInt?
  quoted_tweet_id   BigInt?
  like_count        Int              @default(0)
  retweet_count     Int              @default(0)
  reply_count       Int              @default(0)
  is_deleted        Boolean          @default(false)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
  likes             likes[]
  media             media[]
  notifications     notifications[]
  retweets          retweets[]
  tweet_hashtags    tweet_hashtags[]
  tweet_media       tweet_media[]
  quoted_tweet      tweets?          @relation("tweets_quoted_tweet_idTotweets", fields: [quoted_tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quotes            tweets[]         @relation("tweets_quoted_tweet_idTotweets")
  reply_to_tweet    tweets?          @relation("tweets_reply_to_tweet_idTotweets", fields: [reply_to_tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies           tweets[]         @relation("tweets_reply_to_tweet_idTotweets")
  user              users            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet_mentions    tweet_mentions[]

  @@index([reply_to_tweet_id])
  @@index([quoted_tweet_id])
  @@index([user_id, created_at])
}

model blocks {
  user_id      BigInt
  blocked_id   BigInt
  created_at   DateTime @default(now())
  blocked_user users    @relation("blocks_blocked_idTousers", fields: [blocked_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  blocker      users    @relation("blocks_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, blocked_id])
}

model mutes {
  user_id    BigInt
  muted_id   BigInt
  created_at DateTime @default(now())
  muted_user users    @relation("mutes_muted_idTousers", fields: [muted_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  muter_user users    @relation("mutes_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, muted_id])
}

model follows {
  follower_id        BigInt
  followed_id        BigInt
  created_at         DateTime @default(now())
  with_notifications Boolean  @default(false)
  followed_user      users    @relation("follows_followed_idTousers", fields: [followed_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  follower_user      users    @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([follower_id, followed_id])
  @@index([followed_id, follower_id])
}

model retweets {
  user_id    BigInt
  tweet_id   BigInt
  created_at DateTime @default(now())
  tweet      tweets   @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, tweet_id])
  @@index([tweet_id])
}

model likes {
  user_id    BigInt
  tweet_id   BigInt
  created_at DateTime @default(now())
  tweet      tweets   @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user       users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, tweet_id])
  @@index([tweet_id, user_id])
}

model hashtags {
  id             BigInt           @id @default(autoincrement())
  tag            String?          @unique @db.VarChar(100)
  created_at     DateTime         @default(now())
  count          Int              @default(0)
  tweet_hashtags tweet_hashtags[]
}

model tweet_hashtags {
  tweet_id       BigInt
  hashtag_id     BigInt
  starting_index Int
  hashtag        hashtags @relation(fields: [hashtag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet          tweets   @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([hashtag_id, tweet_id])
  @@index([tweet_id, hashtag_id])
}

model tweet_mentions {
  tweet_id       BigInt
  user_id        BigInt
  starting_index Int
  tweet          tweets @relation(fields: [tweet_id], references: [id])
  user           users  @relation(fields: [user_id], references: [id])

  @@id([tweet_id, user_id])
  @@index([user_id, tweet_id])
}

model messages {
  id                             BigInt                      @id @default(autoincrement())
  user_id                        BigInt
  conversation_id                BigInt
  message_entities               Json?
  created_at                     DateTime                    @default(now())
  conversation_participants      conversation_participants[]
  conversation_with_last_message conversations?              @relation("conversations_last_message_idTomessages")
  conversation                   conversations               @relation("messages_conversation_idToconversations", fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                           users                       @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversation_id, created_at])
}

model conversations {
  id                        BigInt                      @id @default(autoincrement())
  last_message_id           BigInt?                     @unique
  created_at                DateTime                    @default(now())
  conversation_participants conversation_participants[]
  last_message              messages?                   @relation("conversations_last_message_idTomessages", fields: [last_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages                  messages[]                  @relation("messages_conversation_idToconversations")
}

model conversation_participants {
  id                   BigInt        @id @default(autoincrement())
  conversation_id      BigInt
  user_id              BigInt
  last_seen_message_id BigInt?
  notifications_muted  Boolean       @default(false)
  conversations        conversations @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages             messages?     @relation(fields: [last_seen_message_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user                 users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([conversation_id, user_id], map: "conversation_participants_conversation_id_user_id_idx")
  @@index([user_id, conversation_id])
}

model notifications {
  id          BigInt           @id @default(autoincrement())
  actor_id    BigInt
  receiver_id BigInt
  type        NotificationType
  tweet_id    BigInt?
  seen        Boolean          @default(false)
  created_at  DateTime         @default(now())
  actor       users            @relation("notifications_actor_idTousers", fields: [actor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver    users            @relation("notifications_receiver_idTousers", fields: [receiver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet       tweets?          @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([receiver_id, created_at])
}

model media {
  id          BigInt        @id @default(autoincrement())
  user_id     BigInt
  tweet_id    BigInt
  type        MediaType
  url         String
  alt_text    String?
  width       Float?
  height      Float?
  created_at  DateTime      @default(now())
  tweet       tweets        @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet_media tweet_media[]

  @@index([user_id])
}

model tweet_media {
  tweet_id BigInt
  media_id BigInt
  order    Int?
  media    media  @relation(fields: [media_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tweet    tweets @relation(fields: [tweet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tweet_id, media_id])
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
}

enum NotificationType {
  FOLLOW
  LIKE
  REPLY
  QUOTE
  RETWEET
  TWEET
  MENTION
  MESSAGE
}

enum LanguageCode {
  EN
  AR
}
