meta {
  name: create-tweet
  type: http
  seq: 10
}

post {
  url: http://localhost:3000/tweets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "content": " #coffee #loveit #beautiful #lifestyle #tech #gaming #movies #books #education #entrepreneur #startup #motivate #creative #goodvibes #energy #explore #lifeisgood #follow"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
