meta {
  name: create-tweet
  type: http
  seq: 10
}

post {
  url: http://localhost:3000/tweets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "content": "I love football so much, #football @notnowomar"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
