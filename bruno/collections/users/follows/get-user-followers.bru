meta {
  name: get-user-followers
  type: http
  seq: 1
}

get {
  url: {{base_url}}/users/:username/followers
  body: none
  auth: bearer
}

params:path {
  username: notnowomar
}

auth:bearer {
  token: {{access_token}}
}

vars:pre-request {
  base_url: https://love.raven.cmp27.space
}

settings {
  encodeUrl: true
  timeout: 0
}
