meta {
  name: get-user-following
  type: http
  seq: 2
}

get {
  url: {{base_url}}/users/:username/following
  body: none
  auth: bearer
}

params:path {
  username: notnowomar
}

auth:bearer {
  token: {{access_token}}
}

vars:pre-request {
  base_url: http://localhost:3000
}

settings {
  encodeUrl: true
  timeout: 0
}
