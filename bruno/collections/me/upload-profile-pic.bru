meta {
  name: upload-profile-pic
  type: http
  seq: 9
}

post {
  url: http://localhost:3000/me/profile-picture
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:multipart-form {
  profilePicture: @file(/home/tasneem/Pictures/dfghj.webp)
}

settings {
  encodeUrl: true
  timeout: 0
}
