meta {
  name: block-user
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/me/block/Tasneem
  body: none
  auth: inherit
}

script:pre-request {
  const token = bru.getEnvVar("access_token");
  
  if (token) {
    bru.setHeader("Authorization", `Bearer ${token}`);
  } else {
    console.warn("No access_token found in environment variables");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
