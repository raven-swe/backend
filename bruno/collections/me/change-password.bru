meta {
  name: change-password
  type: http
  seq: 1
}

put {
  url: http://localhost:3000/me/password
  body: json
  auth: bearer
}

body:json {
  {
    "currentPassword": "test1234",
    "newPassword": "Test1234"
  }
}

script:pre-request {
  const token = bru.getEnvVar("access_token");
  
  if (token) {
    bru.setHeader("Authorization", `Bearer ${token}`);
  } else {
    console.warn("No access_token found in environment variables");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
