meta {
  name: Oauth Complete
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/oauth/complete
  body: json
  auth: inherit
}

headers {
  X-Client-Type: "web"
}

body:json {
  {
    "creationToken": {{creationToken}},
    "birthDate": {{birthDate}}
  }
}

vars:pre-request {
  creationToken: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJwcm92aWRlciI6ImdpdGh1YiIsInByb3ZpZGVySWQiOiIxNDkxNzgxMjYiLCJlbWFpbCI6Im9tYXJoYXNzYW5lbHNoZXJpZjIwMDNAZ21haWwuY29tIiwibmFtZSI6Ik9tYXIgSGFzc2FuIiwidHlwZSI6ImNyZWF0aW9uIiwiYXZhdGFyX3VybCI6Imh0dHBzOi8vYXZhdGFycy5naXRodWJ1c2VyY29udGVudC5jb20vdS8xNDkxNzgxMjY_dj00IiwiaWF0IjoxNzYxOTk2MDIxLCJleHAiOjE3NjE5OTk2MjF9.2g0Y43NBCNEhJSmqnO6MbRyVS_3lwviYbP5WnDihvK4"
  birthDate: "2003-02-22"
}

script:post-response {
  const responseBody = res.getBody();
  if (responseBody && typeof responseBody === 'object') {
    const token = responseBody.data?.accessToken;
    if (token) {
      bru.setEnvVar('access_token', token);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
