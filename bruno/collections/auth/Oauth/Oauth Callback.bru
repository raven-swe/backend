meta {
  name: Oauth Callback
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/oauth/:provider/callback
  body: json
  auth: inherit
}

params:path {
  provider: github
}

headers {
  X-Client-Type: "web"
}

body:json {
  {
    "providerToken": {{providerToken}}
  }
}

vars:pre-request {
  providerToken: ""
}

settings {
  encodeUrl: true
  timeout: 0
}
