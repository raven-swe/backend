meta {
  name: register-complete
  type: http
  seq: 3
}

post {
  url: http://localhost:3000/auth/register/complete
  body: json
  auth: inherit
}

headers {
  X-Client-Type: ios
}

body:json {
  {
    "password":"OmarGamal3000$",
    "creationToken":"{{creationToken}}"
  }
}

script:post-response {
  const responseBody = res.getBody();
    try {
      const token = responseBody.data.accessToken;
      if (token) {
        bru.setVar("accessToken", token); 
        console.log("Token saved successfully.");
      } else {
        console.warn("Token not found in the response.");
      }
    } catch (error) {
      console.error("Error parsing response body:", error);
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
