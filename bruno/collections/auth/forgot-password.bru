meta {
    name: forget-password
    type: http
    seq: 1
}

post {
  url: http://localhost:3000/auth/password/forgot
  body: json
  auth: inherit
}

body:json {
  {
    "identifier": "tasneem@gmail.com",
    "recaptchaToken": "any"
  }
}

script:post-response {
  const responseBody = res.getBody();
  try {
    const token = responseBody.data.confirmationToken;
    if (token) {
      bru.setVar("confirmationToken", token);
      console.log("Confirmation token saved successfully:", token);
    } else {
      console.warn("Confirmation token not found in the response.");
    }
  } catch (error) {
    console.error("Error parsing response body:", error);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}