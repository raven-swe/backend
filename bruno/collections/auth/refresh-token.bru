meta {
  name: refresh token
  type: http
  seq: 13
}

post {
  url: http://localhost:3000/auth/refresh-token
  body: json
  auth: inherit
}

headers {
  X-Client-Type: web
}

body:json {
  {
  "refreshToken":"a4a3e7ad4c6a75e8cac50b86d2f60fa750d3ce31c7a37faca13e6e9f1ce686efc7d58abf1fd1d4fd71f91b63a3c9822aeb40cde121c74b6824c80b0a9a395e60"
  }
}

script:post-response {
  const responseBody = res.getBody();
    try {
      const token = responseBody.data.accessToken;
      if (token) {
        bru.setVar("accessToken", token); 
        console.log("Token saved successfully.");
      } else {
        console.warn("Token not found in the response.");
      }
    } catch (error) {
      console.error("Error parsing response body:", error);
    }
}

settings {
  encodeUrl: true
  timeout: 0
}
