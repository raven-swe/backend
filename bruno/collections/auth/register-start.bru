meta {
  name: register-start
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/auth/register/start
  body: json
  auth: inherit
}

body:json {
  {
    "email": "test@gmail.com",
    "name": "test",
    "birthDate": "2004-4-1",
    "recaptchaToken":"any"
  }
}

script:post-response {
  const responseBody = res.getBody();
  try {
    const token = responseBody.data.creationToken;
    if (token) {
      bru.setVar("creationToken", token); 
      console.log("Token saved successfully.");
    } else {
      console.warn("Token not found in the response.");
    }
  } catch (error) {
    console.error("Error parsing response body:", error);
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
